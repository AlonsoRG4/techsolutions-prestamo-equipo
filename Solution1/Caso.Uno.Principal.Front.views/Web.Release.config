<?xml version="1.0" encoding="utf-8"?>

<!-- Transformación aplicada al publicar en configuración "Release" (Publish desde Visual Studio). -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <!--
    IMPORTANTE para publicar en Somee / MonsterASP.NET / otro hosting:
    reemplaza "CONNECTION-STRING-DEL-HOSTING" por la cadena de conexión que
    tu proveedor te entrega al crear la base de datos (Panel de control del
    hosting > SQL Server > Connection Strings). Después corre
    Database/Script_TechSolutionsDB.sql contra esa base de datos (Somee y
    MonsterASP.NET incluyen un editor de consultas web para esto).
  -->
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="CONNECTION-STRING-DEL-HOSTING"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="Replace" />
  </system.web>

</configuration>
