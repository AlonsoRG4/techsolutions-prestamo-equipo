      </dependentAssembly>


      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers"
                          publicKeyToken="31bf3856ad364e35" />

        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0"
                         newVersion="3.0.0.0" />
      </dependentAssembly>


      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages"
                          publicKeyToken="31bf3856ad364e35" />

