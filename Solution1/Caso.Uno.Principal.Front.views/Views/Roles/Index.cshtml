@model List<Caso.Uno.Principal.Front.views.ViewModels.RolListaViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Roles";
}

<div class="ts-page-header">
    <div>
        <h2>Roles</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<p class="text-muted small"><i class="bi bi-info-circle"></i> El sistema trabaja únicamente con estos dos roles fijos. Para cambiar el rol de un usuario, ve a <strong>Usuarios</strong>.</p>

<div class="ts-table-wrap">
    <table class="table table-hover align-middle w-100">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Usuarios Asignados</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.TotalUsuarios</td>
                </tr>
            }
        </tbody>
    </table>
</div>
