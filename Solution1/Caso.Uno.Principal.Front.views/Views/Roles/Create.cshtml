@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Nuevo Rol";
}

<div class="ts-page-header">
    <div>
        <h2>Nuevo Rol</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:480px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="ts-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3">
                <label class="form-label">Nombre del Rol</label>
                <input type="text" name="nombre" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary-ts"><i class="bi bi-save"></i> Guardar</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
