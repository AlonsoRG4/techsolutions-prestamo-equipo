@model Caso.Uno.Principal.Front.views.Modelos.Prestamo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Detalle del Préstamo";
}

<div class="ts-page-header">
    <div>
        <h2>Préstamo #@Model.Id <span class="badge @(Model.Estatus == "Prestado" ? "badge-prestado" : "badge-devuelto") ms-2">@Model.Estatus</span></h2>
        <span class="ts-underline"></span>
    </div>
    @if (Model.Estatus == "Prestado")
    {
        using (Html.BeginForm("Devolver", "Prestamos", new { id = Model.Id }, FormMethod.Post, new { data_confirmar = "¿Confirmas la devolución de este equipo?" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary-ts"><i class="bi bi-check2-circle"></i> Registrar Devolución</button>
        }
    }
</div>

<div class="ts-card p-4" style="max-width:640px;">
    <dl class="ts-dl row mb-0">
        <div class="col-md-6"><dt>Equipo</dt><dd>@Model.Equipo.Nombre (@Model.Equipo.Marca @Model.Equipo.Modelo)</dd></div>
        <div class="col-md-6"><dt>Empleado</dt><dd>@Model.Empleado.Nombre — @Model.Empleado.Departamento</dd></div>
        <div class="col-md-6"><dt>Fecha de Préstamo</dt><dd>@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd></div>
        <div class="col-md-6"><dt>Fecha de Entrega</dt><dd>@(Model.FechaEntrega?.ToString("dd/MM/yyyy") ?? "Pendiente")</dd></div>
    </dl>
</div>
<div class="mt-3">
    @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
