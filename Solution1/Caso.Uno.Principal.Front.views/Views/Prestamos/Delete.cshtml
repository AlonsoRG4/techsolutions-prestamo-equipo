@model Caso.Uno.Principal.Front.views.Modelos.Prestamo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Eliminar Préstamo";
}

<div class="ts-page-header">
    <div>
        <h2>¿Eliminar este préstamo?</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:560px;">
    <dl class="ts-dl row mb-0">
        <div class="col-md-6"><dt>Equipo</dt><dd>@Model.Equipo.Nombre</dd></div>
        <div class="col-md-6"><dt>Empleado</dt><dd>@Model.Empleado.Nombre</dd></div>
        <div class="col-md-6"><dt>Estatus</dt><dd>@Model.Estatus</dd></div>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
</div>
