@model Caso.Uno.Principal.Front.views.Modelos.Prestamo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Nuevo Préstamo";
}

<div class="ts-page-header">
    <div>
        <h2>Registrar Préstamo</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:640px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="ts-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label">Equipo Disponible</label>
                @Html.DropDownList("EquipoId", (SelectList)ViewBag.EquipoId, "-- Selecciona un equipo --", new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Empleado</label>
                @Html.DropDownList("EmpleadoId", (SelectList)ViewBag.EmpleadoId, "-- Selecciona un empleado --", new { @class = "form-control" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.FechaPrestamo, new { @class = "form-label" })
                    @Html.EditorFor(m => m.FechaPrestamo, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.FechaEntrega, new { @class = "form-label" })
                    @Html.EditorFor(m => m.FechaEntrega, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>

            <button type="submit" class="btn btn-primary-ts"><i class="bi bi-save"></i> Registrar Préstamo</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
