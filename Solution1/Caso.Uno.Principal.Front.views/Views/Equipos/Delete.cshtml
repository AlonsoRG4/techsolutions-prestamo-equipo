@model Caso.Uno.Principal.Front.views.Modelos.Equipo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Eliminar Equipo";
}

<div class="ts-page-header">
    <div>
        <h2>¿Eliminar este equipo?</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:560px;">
    <dl class="ts-dl row mb-0">
        <div class="col-md-6"><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
        <div class="col-md-6"><dt>Marca / Modelo</dt><dd>@Model.Marca @Model.Modelo</dd></div>
        <div class="col-md-6"><dt>Serie</dt><dd>@Model.Serie</dd></div>
        <div class="col-md-6"><dt>Estado</dt><dd>@Model.Estado</dd></div>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
</div>
