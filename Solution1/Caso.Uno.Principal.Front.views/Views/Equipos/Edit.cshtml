@model Caso.Uno.Principal.Front.views.Modelos.Equipo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editar Equipo";
}

<div class="ts-page-header">
    <div>
        <h2>Editar Equipo</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:640px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="ts-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Marca, new { @class = "form-label" })
                    @Html.EditorFor(m => m.Marca, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Marca, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Modelo, new { @class = "form-label" })
                    @Html.EditorFor(m => m.Modelo, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Modelo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Serie, new { @class = "form-label" })
                @Html.EditorFor(m => m.Serie, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Serie, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Estado, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Estado, new SelectList((string[])ViewBag.Estados, Model.Estado), new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-primary-ts"><i class="bi bi-save"></i> Guardar</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
