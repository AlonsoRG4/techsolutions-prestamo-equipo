@model Caso.Uno.Principal.Front.views.Modelos.Empleado
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Detalles del Empleado";
}

<div class="ts-page-header">
    <div>
        <h2>@Model.Nombre</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:560px;">
    <dl class="ts-dl row mb-0">
        <div class="col-md-6"><dt>@Html.DisplayNameFor(m => m.Departamento)</dt><dd>@Model.Departamento</dd></div>
        <div class="col-md-6"><dt>@Html.DisplayNameFor(m => m.Correo)</dt><dd>@Model.Correo</dd></div>
        <div class="col-md-6"><dt>@Html.DisplayNameFor(m => m.Telefono)</dt><dd>@Model.Telefono</dd></div>
    </dl>
</div>
<div class="mt-3">
    @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary-ts" })
    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
