@model IEnumerable<Caso.Uno.Principal.Front.views.Modelos.Empleado>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Empleados";
}

<div class="ts-page-header">
    <div>
        <h2>Empleados</h2>
        <span class="ts-underline"></span>
    </div>
    @Html.ActionLink("+ Nuevo Empleado", "Create", null, new { @class = "btn btn-primary-ts" })
</div>

<div class="ts-table-wrap">
    <table class="ts-datatable table table-hover align-middle w-100">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Departamento</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Departamento</td>
                    <td>@item.Correo</td>
                    <td>@item.Telefono</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
