@model Caso.Uno.Principal.Front.views.Modelos.Empleado
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editar Empleado";
}

<div class="ts-page-header">
    <div>
        <h2>Editar Empleado</h2>
        <span class="ts-underline"></span>
    </div>
</div>

<div class="ts-card p-4" style="max-width:640px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="ts-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Departamento, new { @class = "form-label" })
                @Html.EditorFor(m => m.Departamento, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Departamento, "", new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                    @Html.EditorFor(m => m.Correo, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                    @Html.EditorFor(m => m.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                </div>
            </div>
            <button type="submit" class="btn btn-primary-ts"><i class="bi bi-save"></i> Guardar</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
