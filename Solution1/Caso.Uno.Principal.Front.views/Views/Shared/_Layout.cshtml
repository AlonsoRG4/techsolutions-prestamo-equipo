@{
    string controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TechSolutions S.A.</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
@if (Request.IsAuthenticated)
{
    <div class="ts-app">
        <aside class="ts-sidebar" id="tsSidebar">
            <div class="ts-brand">
                <span class="ts-brand-icon">TS</span>
                <div>
                    <h1>TechSolutions</h1>
                    <small>Préstamo de Equipo</small>
                </div>
            </div>
            <nav class="nav flex-column py-2">
                <a class="nav-link @(controladorActual == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="ts-nav-section">Operación</div>
                <a class="nav-link @(controladorActual == "Equipos" ? "active" : "")" href="@Url.Action("Index", "Equipos")">
                    <i class="bi bi-pc-display"></i> Equipos
                </a>
                <a class="nav-link @(controladorActual == "Empleados" ? "active" : "")" href="@Url.Action("Index", "Empleados")">
                    <i class="bi bi-people-fill"></i> Empleados
                </a>
                <a class="nav-link @(controladorActual == "Prestamos" ? "active" : "")" href="@Url.Action("Index", "Prestamos")">
                    <i class="bi bi-arrow-left-right"></i> Préstamos
                </a>

                @if (User.IsInRole("Administrador"))
                {
                    <div class="ts-nav-section">Administración</div>
                    <a class="nav-link @(controladorActual == "Usuarios" ? "active" : "")" href="@Url.Action("Index", "Usuarios")">
                        <i class="bi bi-person-badge-fill"></i> Usuarios
                    </a>
                    <a class="nav-link @(controladorActual == "Roles" ? "active" : "")" href="@Url.Action("Index", "Roles")">
                        <i class="bi bi-shield-lock-fill"></i> Roles
                    </a>
                }

                <form action="@Url.Action("LogOff", "Account")" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start" style="cursor:pointer;">
                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                    </button>
                </form>
            </nav>
        </aside>

        <div class="ts-content">
            <header class="ts-topbar">
                <button class="ts-toggle d-lg-none" id="tsToggleSidebar" type="button"><i class="bi bi-list"></i></button>
                <span class="d-none d-lg-block fw-semibold" style="color:var(--ts-azul-2);">@ViewBag.Title</span>
                <div class="ts-usuario">
                    <div class="avatar">@User.Identity.Name.Substring(0,1).ToUpper()</div>
                    <span class="d-none d-md-inline">@User.Identity.Name</span>
                </div>
            </header>

            <main class="ts-main">
                @RenderBody()
            </main>

            <footer class="ts-footer d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year TechSolutions S.A.</span>
                <span>Sistema de Préstamo de Equipo Tecnológico</span>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success position-fixed bottom-0 end-0 m-3 shadow" style="z-index:2000;">@TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger position-fixed bottom-0 end-0 m-3 shadow" style="z-index:2000;">@TempData["MensajeError"]</div>
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
